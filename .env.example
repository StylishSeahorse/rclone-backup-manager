# cp .env.example .env  and fill in the values below.

# Signs admin sessions + encrypts stored Wasabi secrets.   generate: openssl rand -hex 32
SERVER_SECRET=

# Dashboard login (used on first start, when the user table is empty).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Pre-enrolled demo agent's API key. Must start with wbk_.   generate: echo wbk_$(openssl rand -hex 32)
AGENT_API_KEY=

# Host directory the demo agent can see at /data (mounted read-only).
BACKUP_SRC=./demo-data

# Optional
# SERVER_PORT=8080
# COOKIE_SECURE=true          # when behind an HTTPS reverse proxy
# AGENT_HOSTNAME=my-host
